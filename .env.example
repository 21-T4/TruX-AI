# Local setup:
#   cp .env.example .env
#   npm start
# Node.js loads .env using --env-file-if-exists. Never commit your local .env.
# On Cloud Run, set runtime environment variables in the service configuration.
PORT=3000

# Google Cloud / Vertex AI
# Local development needs Google Cloud Application Default Credentials and IAM access.
# Cloud Run should use its attached service identity; do not put service-account keys here.
GOOGLE_CLOUD_PROJECT=trux-ai
# Live API supports: us-central1, us, eu
TRUX_LIVE_LOCATION=us-central1

# Public Firebase web-app configuration for the current TruX-AI project.
# These client configuration identifiers are not server credentials.
FIREBASE_API_KEY=AIzaSyAs_GDrzlBaucHfiff0Y6cA8GVHjFTA62Q
FIREBASE_AUTH_DOMAIN=trux-ai.firebaseapp.com
FIREBASE_PROJECT_ID=trux-ai
FIREBASE_STORAGE_BUCKET=trux-ai.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=59313097411
FIREBASE_APP_ID=1:59313097411:web:32e4158bfb733fa7cfb076
FIREBASE_MEASUREMENT_ID=G-C32LC29QHC
# Optional: Firebase Web Push VAPID public key for notifications.
FCM_VAPID_PUBLIC_KEY=

# Google Cloud Storage for user uploads and generated media.
TRUX_BUCKET_NAME=trux-ai-bucket
# Optional: gs://bucket-name/output-prefix; needed for generated video output.
TRUX_VIDEO_OUTPUT_GCS_URI=
TRUX_VIDEO_MODEL=veo-3.1-fast-generate-001

# Optional; leave blank to derive the app's origin from the request.
TRUX_APP_ORIGIN=

# Optional integrations; fill only when enabling the corresponding feature.
# Required for Composio plugin discovery/actions.
COMPOSIO_API_KEY=
# Both values are required for feedback email delivery through Resend.
RESEND_API_KEY=
TRUX_FEEDBACK_FROM_EMAIL=
