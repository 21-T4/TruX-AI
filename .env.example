# Port configuration
PORT=3000

# Native Vertex AI / Google Gen AI
# Cloud Run uses its attached service identity + Application Default Credentials.
# No service-account email or private key is required.
# Google Cloud project is resolved by @google/genai from Cloud Run ADC.
# Vertex location is resolved by @google/genai; no location variable is required.

# Firebase configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# GitHub OAuth integration
GIT_CLIENT_ID=
GIT_CLIENT_SECRET=

# Cloud Storage & Video output
TRUX_BUCKET_NAME=
TRUX_BACKUP_SECRET=
TRUX_VIDEO_OUTPUT_GCS_URI=
TRUX_VIDEO_MODEL=veo-3.1-fast-generate-001

# Application URLs
TRUX_APP_ORIGIN=
TRUX_BACKGROUND_ORIGIN=http://127.0.0.1:3000
COMPOSIO_API_KEY=
