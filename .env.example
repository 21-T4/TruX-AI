# Port configuration
PORT=3000
# Native Google Gen AI on Vertex AI
# Cloud Run discovers the GCP project ID and region from its metadata server.
# Cloud Run service identity provides Application Default Credentials.

# Firebase configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=


# Object storage remains for large file/media payloads; chat history is stored in Firestore.
TRUX_BUCKET_NAME=
# Authorizes the one-time migration of all legacy bucket chat history into Firestore.
TRUX_BACKUP_SECRET=
TRUX_VIDEO_OUTPUT_GCS_URI=
TRUX_VIDEO_MODEL=veo-3.1-fast-generate-001

# Application URLs
TRUX_APP_ORIGIN=
COMPOSIO_API_KEY=

# Feedback email delivery (Resend). Use a verified sender address for your domain.
RESEND_API_KEY=
TRUX_FEEDBACK_FROM_EMAIL=
