# Port configuration
PORT=3000
# Native Google Gen AI on Vertex AI
# Cloud Run discovers the GCP project ID and region from its metadata server.
# Cloud Run service identity provides Application Default Credentials.

# Firebase configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=


# Cloud Storage & Video output
TRUX_BUCKET_NAME=
TRUX_BACKUP_SECRET=
TRUX_VIDEO_OUTPUT_GCS_URI=
TRUX_VIDEO_MODEL=veo-3.1-fast-generate-001

# Application URLs
TRUX_APP_ORIGIN=
TRUX_BACKGROUND_ORIGIN=http://127.0.0.1:3000
COMPOSIO_API_KEY=
